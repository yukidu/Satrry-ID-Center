{
  "catalog_version": "2026-10-24.1",
  "authority": "M06 official Google Doc, this catalog is an implementation index not a new decision",
  "m06_url": "https://docs.google.com/document/d/10XEaZagWP_hwF1kn3JidrjYyfE3-7L9SZLND2CZdAXA/edit",
  "overview_url": "https://docs.google.com/document/d/1T-SXNilxJ9QnwHotDkFAC3OHIbZtpPo0KJ8PgcDeRLc/edit",
  "production_ready": false,
  "status_definitions": {
    "decided": "正式需求但不等於已實作",
    "developed": "開發分支有程式但不等於正式上線",
    "pending": "尚待確認且禁止自動啟用",
    "unverified": "待端到端驗證"
  },
  "rules": [
    {
      "id": "BAT-A01",
      "name": "Starry-only scope",
      "status": "decided",
      "applicability": "Starry ecosystem only",
      "hglobal_battery_allowed": false
    },
    {
      "id": "BAT-A02",
      "name": "Shared central wallet",
      "status": "decided",
      "wallet_scope": "central user_id across Starry Apps",
      "d1_direct_app_access": false
    },
    {
      "id": "BAT-A03",
      "name": "Per-app gateway auth and rate limiting",
      "status": "developed",
      "rate_limit_default_per_minute": 120,
      "rate_limit_schema_range": [
        1,
        10000
      ],
      "enabled_by_default": false
    },
    {
      "id": "BAT-B01",
      "name": "Reserve/commit/release",
      "status": "developed",
      "user_manual_controls": false,
      "require_real_d1_e2e": true
    },
    {
      "id": "BAT-B02",
      "name": "Timeout full refund",
      "status": "developed",
      "timeout_default_seconds": 180,
      "require_scheduler_and_d1_e2e": true
    },
    {
      "id": "BAT-B03",
      "name": "FEFO and expiry protection",
      "status": "developed",
      "must_not_recredit_expired_lots": true,
      "require_d1_e2e": true
    },
    {
      "id": "BAT-B04",
      "name": "Idempotency and concurrent spending protection",
      "status": "developed",
      "require_concurrency_test": true
    },
    {
      "id": "BAT-B05",
      "name": "Negative battery two instances",
      "status": "pending",
      "enabled": false,
      "wording": "餘額可以接受負數二次，不論數字多大",
      "ambiguities": [
        "two additional successful operations versus two debt cycles",
        "reset period",
        "repayment order",
        "numeric representation and financial safety"
      ],
      "existing_schema_check": "available_units >= 0"
    },
    {
      "id": "BAT-C01",
      "name": "Gift battery expiry",
      "status": "decided",
      "expiry_months": 24,
      "expiry_at_month_end": true,
      "implementation": "unverified"
    },
    {
      "id": "BAT-C02",
      "name": "Signup/approval grants",
      "status": "unverified",
      "signup_proposed_units": 10,
      "first_approval_proposed_units": 20,
      "no_retroactive_grants": true
    },
    {
      "id": "BAT-C03",
      "name": "Ledger archive",
      "status": "unverified",
      "d1_recent_months": 12,
      "r2_archive_after_reconciliation": true
    },
    {
      "id": "BAT-C04",
      "name": "Purchasing batteries",
      "status": "decided",
      "enabled": false
    }
  ]
}
